# Skopíruj do .env a doplň hodnoty zo Supabase (Project Settings → API Keys)
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Len pre `npm run emails:apply` – patrí do .env.local (nie do gitu)
# SUPABASE_ACCESS_TOKEN=sbp_...              https://supabase.com/dashboard/account/tokens
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
# SMTP_SENDER_EMAIL=tvoj-overeny-odosielatel@...
# SMTP_SENDER_NAME=Rozvrh
